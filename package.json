{
  "name": "readme-gen",
  "version": "0.1.0",
  "description": "Generate a polished, evidence-backed README.md for a public GitHub repository, in the style you choose.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "readme-gen": "bin/readme-gen.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "keywords": [
    "readme",
    "github",
    "cli",
    "documentation",
    "llm"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
